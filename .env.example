# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Where captured emails are stored.
# Set this to a Postgres connection string in production - on Railway, add a
# Postgres service and DATABASE_URL is injected automatically.
# If it is unset, emails append to leads.jsonl, which is WIPED on every Railway
# deploy. That fallback is for local development only.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Upload limits for the "upload the book as a PDF" feature.
# MAX_UPLOAD_MB caps the file size; MAX_BOOK_CHARS caps how much extracted text
# is sent to the API, which is what actually drives cost per request.
MAX_UPLOAD_MB=20
MAX_BOOK_CHARS=300000

# Set to 1 to enable Flask debug mode. Never enable this in production.
# FLASK_DEBUG=0
