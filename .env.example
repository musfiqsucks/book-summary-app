# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Email storage -----------------------------------------------------------
# Captured emails go to Postgres when this is set. On Railway: New -> Database ->
# Add PostgreSQL, and DATABASE_URL is injected into this service automatically.
# The pdf_leads table is created on the first download.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
#
# WITHOUT DATABASE_URL emails append to leads.jsonl on the container disk, which
# Railway WIPES on every deploy. Attach a Postgres service (or mount a Volume at
# /data, which is picked up automatically) before collecting real addresses.
# LEADS_FILE=/data/leads.jsonl
#
# Set a long random value to enable GET /admin/leads?token=... to export the
# captured emails as JSON. While this is unset the endpoint returns 404.
# LEADS_TOKEN=

# --- PDF upload --------------------------------------------------------------
# MAX_UPLOAD_MB caps the file size. MAX_BOOK_CHARS caps how much extracted text
# is sent to the API, which is what actually drives cost per request - roughly
# 75k input tokens at 300000 chars.
MAX_UPLOAD_MB=5
MAX_BOOK_CHARS=300000

# Set to 1 to enable Flask debug mode. Never enable this in production.
# FLASK_DEBUG=0
